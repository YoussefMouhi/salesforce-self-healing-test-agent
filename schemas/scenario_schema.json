{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["scenario_id", "steps"],
  "properties": {
    "scenario_id": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string" },
          "target": { "type": "string" },
          "value": { "type": "string" },
          "expected": { "type": "string" }
        }
      }
    }
  }
}
